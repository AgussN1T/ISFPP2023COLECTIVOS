													"_parent": {
														"$ref": "AAAAAAGL8m/FWSs+Xnw="
													},
													"name": "writeToFile",
													"documentation": "private void writeToFile(List<Linea> list, String file) {\r\n\t\tFormatter outFile = null;\t\t\r\n\t\ttry {\r\n\t\t\toutFile = new Formatter(file);\r\n\t\t\t\r\n\t\t\tfor (Linea e : list) {\t\t\t\t\r\n\t\t\t\toutFile.format(\"%s;%s;\\n\", e.getId());\r\n\t\t\t}for (Linea linea : list) {\r\n\t            outFile.format(\"%s;%s;\", linea.getId(),null);\r\n\t                outFile.format(\"%s;\");\r\n\t            outFile.format(\"\\n\");\r\n\t       \r\n\t\t\t}} catch (FileNotFoundException fileNotFoundException) {\r\n\t\t\tSystem.err.println(\"Error creating file.\");\r\n\t\t} catch (FormatterClosedException formatterClosedException) {\r\n\t\t\tSystem.err.println(\"Error writing to file.\");\r\n\t\t} finally {\r\n\t\t\tif (outFile != null)\r\n\t\t\t\toutFile.close();\r\n\t\t}\r\n\t}",
													"isStatic": true,
													"parameters": [
														{
															"_type": "UMLParameter",
															"_id": "AAAAAAGL8m/FWitELXg=",
															"_parent": {
