												"$ref": "AAAAAAGL8m/QXS5WtPI="
											},
											"name": "outDegree",
											"documentation": "Returns the number of edges leaving vertex v.\nNote that for an undirected graph, this is the same result\nreturned by inDegree\n@throws IllegalArgumentException if v is not a valid vertex",
											"visibility": "package",
											"parameters": [
