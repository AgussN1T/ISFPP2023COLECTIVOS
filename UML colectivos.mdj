											"name": "get",
											"documentation": "Returns the value associated with the specified key, or null if no such entry exists.\n@param key  the key whose associated value is to be returned\n@return the associated value, or null if no such entry exists",
											"visibility": "package",
											"parameters": [
												{
													"_type": "UMLParameter",
													"_id": "AAAAAAGL8m/TSTAJb48=",
													"_parent": {
