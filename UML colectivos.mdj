											"_parent": {
												"$ref": "AAAAAAGL8m/TSDABZTo="
											},
											"name": "put",
											"documentation": "Associates the given value with the given key. If an entry with\nthe key was already in the map, this replaced the previous value\nwith the new one and returns the old value. Otherwise, a new\nentry is added and null is returned.\n@param key    key with which the specified value is to be associated\n@param value  value to be associated with the specified key\n@return the previous value associated with the key (or null, if no such entry)",
											"visibility": "package",
											"parameters": [
												{
													"_type": "UMLParameter",
													"_id": "AAAAAAGL8m/TSTAMUMk=",
													"_parent": {
