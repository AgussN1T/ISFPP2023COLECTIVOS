														"$ref": "AAAAAAGL8m/VwTEHg88="
													},
													"name": "rotate",
													"documentation": "Rotates Position p above its parent.  Switches between these\nconfigurations, depending on whether p is a or p is b.\n<pre>\nb                  a\n/ \\                / \\\na  t2             t0   b\n/ \\                    / \\\nt0  t1                 t1  t2\n</pre>\nCaller should ensure that p is not the root.",
													"parameters": [
														{
															"_type": "UMLParameter",
															"_id": "AAAAAAGL8m/VwzEpJdE=",
															"_parent": {
																"$ref": "AAAAAAGL8m/VwzEoJ5k="
															},
															"name": "p",
															"type": {
																"$ref": "AAAAAAGL8m/TnTAwAD4="
															}
														},
														{
															"_type": "UMLParameter",
															"_id": "AAAAAAGL8m/VwzEqTmY=",
															"_parent": {
																"$ref": "AAAAAAGL8m/VwzEoJ5k="
															},
															"type": "void",
															"direction": "return"
														}
													]
												},
												{
													"_type": "UMLOperation",
													"_id": "AAAAAAGL8m/VwzErAhU=",
													"_parent": {
														"$ref": "AAAAAAGL8m/VwTEHg88="
													},
													"name": "restructure",
													"documentation": "Returns the Position that becomes the root of the restructured subtree.\nAssumes the nodes are in one of the following configurations:\n<pre>\nz=a                 z=c           z=a               z=c\n/  \\                /  \\          /  \\              /  \\\nt0  y=b             y=b  t3       t0   y=c          y=a  t3\n/  \\            /  \\               /  \\         /  \\\nt1  x=c         x=a  t2            x=b  t3      t0   x=b\n/  \\        /  \\               /  \\              /  \\\nt2  t3      t0  t1             t1  t2            t1  t2\n</pre>\nThe subtree will be restructured so that the node with key b becomes its root.\n<pre>\nb\n/   \\\na       c\n/ \\     / \\\nt0  t1  t2  t3\n</pre>\nCaller should ensure that x has a grandparent.",
													"parameters": [
														{
															"_type": "UMLParameter",
															"_id": "AAAAAAGL8m/VwzEsfZE=",
															"_parent": {
																"$ref": "AAAAAAGL8m/VwzErAhU="
															},
															"name": "x",
															"type": {
																"$ref": "AAAAAAGL8m/TnTAwAD4="
															}
														},
														{
															"_type": "UMLParameter",
															"_id": "AAAAAAGL8m/VwzEtWxU=",
															"_parent": {
																"$ref": "AAAAAAGL8m/VwzErAhU="
															},
															"type": {
																"$ref": "AAAAAAGL8m/TnTAwAD4="
															},
															"direction": "return"
														}
													]
												}
											]
