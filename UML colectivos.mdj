													},
													"direction": "return"
												}
											]
										},
										{
											"_type": "UMLOperation",
											"_id": "AAAAAAGL8m/TSTAPU/M=",
											"_parent": {
												"$ref": "AAAAAAGL8m/TSDABZTo="
											},
											"name": "remove",
											"documentation": "Removes the entry with the specified key, if present, and returns\nits associated value. Otherwise does nothing and returns null.\n@param key  the key whose entry is to be removed from the map\n@return the previous value associated with the removed key, or null if no such entry exists",
											"visibility": "package",
											"parameters": [
												{
													"_type": "UMLParameter",
													"_id": "AAAAAAGL8m/TSTAQ8nY=",
